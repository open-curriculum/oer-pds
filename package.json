{
  "name": "open-instructional-systems",
  "description": "A pedagogical design system for open education — tokens, patterns, themes, renderers, and validation rules for making instructional intent portable, adaptable, automatable, and researchable.",
  "homepage": "https://github.com/open-curriculum/oer-pds",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=./apps/docs",
    "build": "pnpm build:spec && pnpm build:registry && pnpm build:docs",
    "build:spec": "turbo run build --filter=./packages/ois-spec",
    "build:registry": "turbo run build --filter=./packages/ois-registry",
    "build:docs": "turbo run build --filter=./apps/docs",
    "generate": "turbo run generate --filter=./packages/ois-registry",
    "lint": "turbo run lint",
    "format": "turbo run format --no-daemon",
    "format:fix": "turbo run format:fix --no-daemon",
    "change:gen": "changeset add",
    "change:version": "changeset version",
    "release": "pnpm -r publish --access public --filter \"./packages/**\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/changelog-git": "^0.2.0",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20",
    "tsx": "^4.7.2",
    "turbo": "^2.0.9"
  },
  "packageManager": "pnpm@9.1.2",
  "pnpm": {
    "overrides": {
      "@astrojs/sitemap": "3.2.1"
    }
  }
}
