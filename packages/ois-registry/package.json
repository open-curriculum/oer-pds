{
  "name": "@ois/registry",
  "version": "0.1.0",
  "description": "YAML data files and build utilities for the Open Instructional Systems registry",
  "license": "CC0-1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-index.ts && tsx scripts/build-llms.ts",
    "generate": "tsx scripts/build-index.ts && tsx scripts/build-llms.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "biome lint ./src ./scripts",
    "format": "biome format ./src ./scripts"
  },
  "dependencies": {
    "@ois/spec": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "tsx": "^4.7.2",
    "typescript": "^5.5.4"
  }
}
