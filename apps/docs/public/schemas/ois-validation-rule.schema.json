{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-instructional-systems.org/schemas/ois-validation-rule.schema.json",
  "title": "OIS Validation Rule",
  "description": "A rule that checks alignment between pedagogical token values",
  "type": "object",
  "required": ["id", "name", "severity", "condition", "expected", "message"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },
    "condition": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "present": { "type": "boolean" },
        "notValues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "present": { "type": "boolean" },
        "includes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "message": { "type": "string" },
    "rationale": { "type": "string" }
  }
}
